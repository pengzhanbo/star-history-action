    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "dayjs": "^1.11.23",
    "imagemin": "^9.0.1",
    "imagemin-jpegtran": "^8.0.0",
    "imagemin-pngquant": "^10.0.0",
    "jsdom": "^30.0.1",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@pengzhanbo/oxc-config": "^2.9.1",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.2.0",
    "@types/imagemin": "^9.0.1",
    "@types/imagemin-jpegtran": "^5.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
