{
  "name": "star-history-action",
  "version": "1.0.0",
  "description": "A GitHub Action to generate a star history chart for a repository.",
  "keywords": [
    "actions",
    "github",
    "star-history"
  ],
  "license": "MIT",
  "author": "pengzhanbo <q942450674@outlook.com> (https://github.com/pengzhanbo)",
