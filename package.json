{
  "name": "star-history-action",
  "version": "1.0.0",
  "description": "A GitHub Action to generate a star history chart for a repository.",
  "keywords": [
    "actions",
    "github",
    "star-history"
  ],
  "homepage": "https://github.com/pengzhanbo/star-history-action",
  "bugs": "https://github.com/pengzhanbo/star-history-action/issues",
  "license": "MIT",
  "author": "pengzhanbo <q942450674@outlook.com> (https://github.com/pengzhanbo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pengzhanbo/star-history-action.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint . --type-aware --type-check && oxfmt . --check",
    "format": "oxlint . --type-check --type-aware --fix && oxfmt .",
    "test": "vitest --coverage",
    "prepare": "simple-git-hooks",
    "release:changelog": "conventional-changelog -p angular",
    "release:prepare": "pnpm run build && pnpm run release:changelog && oxfmt ./CHANGELOG.md",
    "release": "bumpp package.json --execute=\"pnpm run release:prepare\" --commit \"build: publish v%s\" --push --tag --all"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@pengzhanbo/utils": "^3.11.0",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "dayjs": "^1.11.23",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.14.0",
    "subset-font": "^2.7.0",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@pengzhanbo/oxc-config": "^2.9.2",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged --allow-empty"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
